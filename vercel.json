{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/faucet",
      "schedule": "0 6 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/api/v3/:path*",
      "destination": "https://physicoin-v3.vercel.app/api/:path*"
    }
  ]
}
